{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-gtm-ecommerce" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-tags"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_information }}</div>

        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-gtm-ecommerce" class="form-horizontal">
          <fieldset>
            <legend>{{ text_general }}</legend>

            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-store"><span data-toggle="tooltip" title="{{ help_store }}">{{ entry_store }}</span></label>
              <div class="col-sm-10">
                <select id="input-store" class="form-control" onchange="if (this.value) { window.location = this.value; }">
                  {% for store in stores %}
                  <option value="{{ store.href }}" {% if store.store_id == store_id %}selected="selected"{% endif %}>{{ store.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="analytics_gtm_ecommerce_status" id="input-status" class="form-control">
                  {% if analytics_gtm_ecommerce_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>

            <div class="form-group {% if error_gtm_id %}has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-gtm-id"><span data-toggle="tooltip" title="{{ help_gtm_id }}">{{ entry_gtm_id }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="analytics_gtm_ecommerce_gtm_id" value="{{ analytics_gtm_ecommerce_gtm_id }}" placeholder="GTM-XXXXXXX" id="input-gtm-id" class="form-control" autocomplete="off">
                {% if error_gtm_id %}
                <div class="text-danger">{{ error_gtm_id }}</div>
                {% endif %}
              </div>
            </div>

            <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_duplicate }}</div>
            <div class="alert alert-info"><i class="fa fa-shield"></i> {{ text_consent }}</div>
          </fieldset>

          <fieldset>
            <legend>{{ text_ecommerce }}</legend>

            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-ecommerce-status"><span data-toggle="tooltip" title="{{ help_ecommerce }}">{{ entry_ecommerce_status }}</span></label>
              <div class="col-sm-10">
                <select name="analytics_gtm_ecommerce_ecommerce_status" id="input-ecommerce-status" class="form-control">
                  {% if analytics_gtm_ecommerce_ecommerce_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ text_event_mapping }}</label>
              <div class="col-sm-10">
                <p class="form-control-static">{{ help_event_mapping }}</p>
              </div>
            </div>

            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead>
                  <tr>
                    <td>{{ text_event_mapping }}</td>
                    <td style="width: 220px;">{{ entry_status }}</td>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>gtm_view_item</strong> &rarr; view_item<br><small>{{ entry_view_item }}</small></td>
                    <td>
                      <select name="analytics_gtm_ecommerce_track_view_item" class="form-control">
                        <option value="1" {% if analytics_gtm_ecommerce_track_view_item %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if not analytics_gtm_ecommerce_track_view_item %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </td>
                  </tr>
                  <tr>
                    <td><strong>gtm_add_to_cart</strong> &rarr; add_to_cart<br><small>{{ entry_add_to_cart }}</small></td>
                    <td>
                      <select name="analytics_gtm_ecommerce_track_add_to_cart" class="form-control">
                        <option value="1" {% if analytics_gtm_ecommerce_track_add_to_cart %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if not analytics_gtm_ecommerce_track_add_to_cart %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </td>
                  </tr>
                  <tr>
                    <td><strong>gtm_remove_from_cart</strong> &rarr; remove_from_cart<br><small>{{ entry_remove_from_cart }}</small></td>
                    <td>
                      <select name="analytics_gtm_ecommerce_track_remove_from_cart" class="form-control">
                        <option value="1" {% if analytics_gtm_ecommerce_track_remove_from_cart %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if not analytics_gtm_ecommerce_track_remove_from_cart %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </td>
                  </tr>
                  <tr>
                    <td><strong>gtm_view_cart</strong> &rarr; view_cart<br><small>{{ entry_view_cart }}</small></td>
                    <td>
                      <select name="analytics_gtm_ecommerce_track_view_cart" class="form-control">
                        <option value="1" {% if analytics_gtm_ecommerce_track_view_cart %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if not analytics_gtm_ecommerce_track_view_cart %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </td>
                  </tr>
                  <tr>
                    <td><strong>gtm_begin_checkout</strong> &rarr; begin_checkout<br><small>{{ entry_begin_checkout }}</small></td>
                    <td>
                      <select name="analytics_gtm_ecommerce_track_begin_checkout" class="form-control">
                        <option value="1" {% if analytics_gtm_ecommerce_track_begin_checkout %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if not analytics_gtm_ecommerce_track_begin_checkout %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </td>
                  </tr>
                  <tr>
                    <td><strong>gtm_purchase</strong> &rarr; purchase<br><small>{{ entry_purchase }}</small></td>
                    <td>
                      <select name="analytics_gtm_ecommerce_track_purchase" class="form-control">
                        <option value="1" {% if analytics_gtm_ecommerce_track_purchase %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if not analytics_gtm_ecommerce_track_purchase %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
